# Bohurupi root environment (copy to .env, used by docker compose)

# ---- Core ----
ENV=prod
DEBUG=false
CORS_ORIGINS=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# ---- Persistence (compose overrides these for containers) ----
DATABASE_URL=postgresql+psycopg://bohurupi:bohurupi@localhost:5432/bohurupi
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=./storage

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# This user is promoted to admin on registration
ADMIN_EMAIL=admin@example.com

# ---- LLM: Z.AI GLM (required for chat) ----
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL=glm-4.6

# ---- Agent tool: web search (optional) ----
TAVILY_API_KEY=

# ---- OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- TTS ----
ENGINE_ORDER=kokoro,edge
KOKORO_AUTO_DOWNLOAD=true
WHISPER_MODEL_SIZE=base
WATERMARK_ENABLED=true
MAX_UPLOAD_MB=20

# ---- Plan quotas (TTS chars/day) ----
QUOTA_FREE_CHARS=20000
QUOTA_PRO_CHARS=200000
QUOTA_STUDIO_CHARS=1000000

# ---- Web (build arg for the Next.js container) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
