# ---- Bohurupi API configuration (copy to .env) ----

ENV=dev
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# CORS (comma-separated origins of the web app)
CORS_ORIGINS=http://localhost:3000

# Database (SQLite for dev; Postgres in Docker)
DATABASE_URL=sqlite:///./bohurupi.db
# DATABASE_URL=postgresql+psycopg://bohurupi:bohurupi@localhost:5432/bohurupi

REDIS_URL=redis://localhost:6379/0

# Storage root for audio, voice samples, models
STORAGE_PATH=./storage

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# This user is promoted to admin on registration
ADMIN_EMAIL=admin@example.com

# LLM (Z.AI GLM - OpenAI-compatible endpoint)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL=glm-4.6

# Web search tool for the agent (optional; agent runs without it)
TAVILY_API_KEY=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TTS engines, ordered by quality. Comma-separated: kokoro,edge
ENGINE_ORDER=kokoro,edge
# Auto-download Kokoro ONNX model (~330 MB) into STORAGE_PATH/models on first use
KOKORO_AUTO_DOWNLOAD=true
# Local STT model size: tiny, base, small
WHISPER_MODEL_SIZE=base

# Watermark generated audio (requires the `fx` extra with audioseal)
WATERMARK_ENABLED=true

# Upload limits
MAX_UPLOAD_MB=20

# Plan quotas (chars of TTS per day)
QUOTA_FREE_CHARS=20000
QUOTA_PRO_CHARS=200000
QUOTA_STUDIO_CHARS=1000000
